{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "docs",
  "regions": ["hkg1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__route=:path*" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "statusCode": 308 }
  ],
  "headers": [
    { "source": "/admin/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" } ] }
  ]
}
