{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.py": { "maxDuration": 30 } },
  "outputDirectory": "docs",
  "headers": [
    { "source": "/admin/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" } ] }
  ]
}
