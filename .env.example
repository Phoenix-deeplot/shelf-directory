# Copy this file to .env for local Vercel development. Never commit .env.

# PostgreSQL used by the Operations console. `DATABASE_URL` is enough locally.
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/postgres"
# OPS_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/postgres"

# Admin API: at least 12 characters; use a unique local secret.
ADMIN_PASSWORD="replace-with-a-unique-local-secret-of-12-or-more-characters"
# Fine-grained GitHub token scoped to this repository: Issues RW, Actions RW, Contents RO.
ADMIN_GITHUB_TOKEN="github_pat_replace_me"
SHELF_REPO="Phoenix-deeplot/shelf-directory"

# Visitor submissions are optional locally. Use a distinct, issue-write-only token.
SUBMIT_GITHUB_TOKEN=""
DIRECTORY_URL="http://localhost:3000/"
ALLOW_LOCAL_ORIGIN="1"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,https://books.zhitree.cn,https://adminbook.zhitree.cn"
IP_SALT="replace-with-a-long-random-string"

# Optional: enables sync and heat metrics (use either pair).
# UPSTASH_REDIS_REST_URL="https://YOUR_INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-me"
# KV_REST_API_URL="https://YOUR_INSTANCE.upstash.io"
# KV_REST_API_TOKEN="replace-me"

# Optional runtime tuning.
# SYNC_QUOTA="12000000"
# SYNC_TTL_DAYS="180"
# STAT_DAILY_EVENTS="1000"
